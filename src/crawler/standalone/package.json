{
  "name": "engine-harvester",
  "version": "1.0.0",
  "description": "Automated GitHub repository crawler and engine sanitizer with blacklist and cooldown timers",
  "main": "harvester.ts",
  "scripts": {
    "start": "ts-node harvester.ts",
