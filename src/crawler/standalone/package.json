  "license": "Apache-2.0",
  "dependencies": {
    "@google/genai": "^0.1.2",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}
